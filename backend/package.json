{
  "name": "dealplus-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch",
    "start:leads": "nest start lead-service --watch",
    "start:documents": "nest start document-service --watch",
    "start:rfp": "nest start rfp-service --watch",
    "start:opportunities": "nest start opportunity-service --watch",
    "start:approvals": "nest start approval-service --watch",
    "start:assignments": "nest start assignment-service --watch",
    "start:compliance": "nest start compliance-service --watch",
    "start:delivery": "nest start delivery-service --watch",
    "start:notifications": "nest start notification-service --watch",
    "start:reporting": "nest start reporting-service --watch",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test": "jest",
    "test:documents": "jest --selectProjects documents",
    "test:leads": "jest --config apps/lead-service/jest.config.js",
    "test:opportunities": "jest --config apps/opportunity-service/jest.config.js",
    "test:assignments": "jest --config apps/assignment-service/jest.config.js",
    "build:leads": "nest build lead-service",
    "typeorm": "typeorm-ts-node-commonjs -d apps/approval-service/src/database/data-source.ts",
    "migration:prepare:approval": "ts-node apps/approval-service/src/database/ensure-typeorm-metadata.ts",
    "migration:generate:approval": "npm run migration:prepare:approval && npm run typeorm -- migration:generate",
    "migration:run:approval": "npm run migration:prepare:approval && npm run typeorm -- migration:run",
    "migration:revert:approval": "npm run typeorm -- migration:revert",
    "migration:show:approval": "npm run typeorm -- migration:show",
    "migration:generate": "node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:generate -d apps/document-service/data-source.ts apps/document-service/src/migrations/InitialDocumentSchema",
    "migration:run": "node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d apps/document-service/data-source.ts",
    "migration:revert": "node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d apps/document-service/data-source.ts",
    "migration:show": "node ./node_modules/typeorm/cli-ts-node-commonjs.js migration:show -d apps/document-service/data-source.ts",
    "migration:lead:generate": "typeorm-ts-node-commonjs migration:generate apps/lead-service/src/database/migrations/InitialLeadSchema -d apps/lead-service/src/database/data-source.ts",
    "migration:lead:run": "typeorm-ts-node-commonjs migration:run -d apps/lead-service/src/database/data-source.ts",
    "migration:lead:revert": "typeorm-ts-node-commonjs migration:revert -d apps/lead-service/src/database/data-source.ts",
    "migration:lead:show": "typeorm-ts-node-commonjs migration:show -d apps/lead-service/src/database/data-source.ts",
    "opp:migrate": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d apps/opportunity-service/src/database/data-source.ts",
    "opp:migrate:revert": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d apps/opportunity-service/src/database/data-source.ts",
    "opp:migrate:show": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:show -d apps/opportunity-service/src/database/data-source.ts",
    "asg:migrate": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d apps/assignment-service/src/database/data-source.ts",
    "asg:migrate:revert": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d apps/assignment-service/src/database/data-source.ts",
    "asg:migrate:show": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:show -d apps/assignment-service/src/database/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/s3-request-presigner": "^3.1172.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.6.1",
    "file-type": "^16.5.4",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
