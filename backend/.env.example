# DealPlus backend — reference for local / shared MySQL (one DB per service).
# Copy connection settings into each apps/<service>/.env (never commit real .env).

NODE_ENV=development

# --- Service ports (local dev) ---
API_GATEWAY_PORT=3000
LEAD_SERVICE_PORT=3002
OPPORTUNITY_SERVICE_PORT=3003
RFP_SERVICE_PORT=3004
DOCUMENT_SERVICE_PORT=3005
APPROVAL_SERVICE_PORT=3006
ASSIGNMENT_SERVICE_PORT=3007
COMPLIANCE_SERVICE_PORT=3008

# --- API Gateway upstreams (used by apps/api-gateway/.env) ---
LEAD_SERVICE_URL=http://localhost:3002
OPPORTUNITY_SERVICE_URL=http://localhost:3003
RFP_SERVICE_URL=http://localhost:3004
DOCUMENT_SERVICE_URL=http://localhost:3005
APPROVAL_SERVICE_URL=http://localhost:3006
ASSIGNMENT_SERVICE_URL=http://localhost:3007
COMPLIANCE_SERVICE_URL=http://localhost:3008

# Command Module (optional Phase 1)
IAM_API_URL=
GATEWAY_PROXY_TIMEOUT_MS=120000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Shared MySQL host credentials (override DB_NAME per service) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=dealplus
DB_PASSWORD=change_me

# TLS: DISABLED for local Docker MySQL; VERIFY_CA + DB_SSL_CA=./ca.pem for managed MySQL
DB_SSL_MODE=DISABLED
# DB_SSL_CA=./ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

# Per-service database names (do not rename existing server databases)
# LEAD: lead_db | OPPORTUNITY: opportunity_db | RFP: rfp_db
# DOCUMENT: document_db | APPROVAL: approval_db | ASSIGNMENT: assignment_db | COMPLIANCE: compliance_db

# Redis (RFP workers)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Document Service — object storage & scan
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dealplus
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=dealplus-documents
MINIO_USE_SSL=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Approval Scope 1 mock token (development)
APPROVAL_MOCK_TOKEN_SECRET=approval-service-local-dev-secret

# Command Module session (optional)
REDIS_SERVICE_URL=
SESSION_COOKIE_NAME=session_id