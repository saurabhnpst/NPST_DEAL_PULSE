# Legacy combined template — prefer per-service files under apps/<service>/.env.example
# See docs/environment-configuration.md

# Quick reference: copy the relevant block into apps/<service>/.env

# --- api-gateway (apps/api-gateway/.env) ---
# PORT=3000
# IAM_API_URL=http://localhost:3012
# CORS_ORIGINS=http://localhost:5173
# LEAD_SERVICE_URL=http://localhost:3002
# DOCUMENT_SERVICE_URL=http://localhost:3005
# RFP_SERVICE_URL=http://localhost:3004

# --- MySQL services (shared host, separate DB_NAME per service) ---
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=dealplus
# DB_PASSWORD=change_me
# DB_NAME=<lead_db|rfp_db|document_db|...>

# --- Command Module session validation ---
# REDIS_SERVICE_URL=
# SESSION_COOKIE_NAME=session_id

# --- document-service object storage ---
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=dealplus
# MINIO_SECRET_KEY=change_me_minio
# MINIO_BUCKET=dealplus-documents

# --- rfp-service workers ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# DOCUMENT_SERVICE_BASE_URL=http://localhost:3005