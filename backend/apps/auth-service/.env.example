NODE_ENV=development
PORT=3001

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session store (shared `sess:*` shape with libs/command-module-auth)
AUTH_REDIS_URL=redis://127.0.0.1:6379
SESSION_COOKIE_NAME=session_id

# Local identity (development only). Passwords stay in env — not in source code.
# Username is matched case-insensitively; frontend may send work email in the username field.
AUTH_LOCAL_USERS=[{"username":"admin","password":"REPLACE_ME","email":"admin@local.invalid","name":"Admin User","roles":["admin"],"permissions":["dealplus.access"]}]