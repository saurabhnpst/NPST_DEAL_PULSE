# Copy to `.env` in this folder (apps/compliance-service/.env).
# Run services from `backend/` so paths resolve correctly.

NODE_ENV=development
PORT=3008

DB_HOST=localhost
DB_PORT=3306
DB_USER=dealplus
DB_PASSWORD=change_me
DB_NAME=compliance_db

# Local MySQL: DISABLED. Managed TLS: REQUIRED or VERIFY_CA with DB_SSL_CA=./ca.pem
DB_SSL_MODE=DISABLED
# DB_SSL_CA=./ca.pem
# DB_SSL_REJECT_UNAUTHORIZED=true

REDIS_SERVICE_URL=
SESSION_COOKIE_NAME=session_id