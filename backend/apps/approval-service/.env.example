NODE_ENV=development
PORT=3006

# Copy to .env in this directory (gitignored). Use placeholders only.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dealplus
DB_PASSWORD=change_me
DB_NAME=approval_db
DB_SSL_MODE=DISABLED
# For managed MySQL with TLS: DB_SSL_MODE=REQUIRED and DB_SSL_CA=./ca.pem

REDIS_SERVICE_URL=
SESSION_COOKIE_NAME=session_id

APPROVAL_MOCK_TOKEN_SECRET=approval-service-local-dev-secret
APPROVAL_TOKEN_TTL_SECONDS=3600
APPROVAL_ESCALATION_ENABLED=true
APPROVAL_ESCALATION_APPROVED=false
APPROVAL_ESCALATION_MS=1000