# Copy to .env in this directory (gitignored). Use placeholders only; never commit real hosts or passwords.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dealplus
DB_PASSWORD=replace_with_db_password
DB_NAME=approval_db
DB_SSL_MODE=DISABLED
# For managed MySQL with TLS: DB_SSL_MODE=REQUIRED and DB_SSL_CA=./ca.pem (ca.pem is gitignored; obtain from your provider locally)