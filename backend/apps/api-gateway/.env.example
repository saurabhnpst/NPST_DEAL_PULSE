NODE_ENV=development
# Use 3010 when port 3000 is occupied by another app (Grafana, etc.)
PORT=3010

# CORS — comma-separated browser origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_CREDENTIALS=true

# Identity upstream for /api/auth, /api/me (no /api/v1 prefix on these paths).
# Local DealPulse auth-service: http://localhost:3001
# External Command Module iam-api: http://localhost:3012
IAM_API_URL=http://localhost:3001

GATEWAY_PROXY_TIMEOUT_MS=120000

# Active microservice upstreams (host URLs; Docker deployments use service DNS names)
LEAD_SERVICE_URL=http://localhost:3002
OPPORTUNITY_SERVICE_URL=http://localhost:3003
APPROVAL_SERVICE_URL=http://localhost:3006
ASSIGNMENT_SERVICE_URL=http://localhost:3007
COMPLIANCE_SERVICE_URL=http://localhost:3008
DOCUMENT_SERVICE_URL=http://localhost:3005
RFP_SERVICE_URL=http://localhost:3004

# Optional: validate sessions at the gateway via Command Module Redis (same as iam-api sess: keys)
# COMMAND_MODULE_REDIS_SERVICE_URL=redis://service-read:password@localhost:6379
# SESSION_COOKIE_NAME=session_id