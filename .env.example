# DealPlus infrastructure (root). Copy to `.env` for local Docker Compose.
# Service-specific DB credentials live under backend/apps/<service>/.env

NODE_ENV=development

# Shared MySQL (Docker service name: mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_USER=dealplus
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=approval_db

# RabbitMQ (docker service: rabbitmq)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=dealplus
RABBITMQ_PASSWORD=change_me
RABBITMQ_URL=amqp://dealplus:change_me@localhost:5672

# Redis — DealPlus workers (RFP BullMQ). Command Module uses its own Redis ACL users.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO object storage (docker service: minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=dealplus
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_USE_SSL=false

# API gateway / shared auth (optional for local stacks)
API_GATEWAY_PORT=3000
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

M365_TENANT_ID=replace_with_tenant_id
M365_CLIENT_ID=replace_with_client_id
M365_CLIENT_SECRET=replace_with_client_secret
TEAMS_BOT_APP_ID=replace_with_bot_app_id
TEAMS_BOT_APP_PASSWORD=replace_with_bot_app_password
EMAIL_FROM=no-reply@example.invalid

# Approval service runtime (Scope 1 mock)
APPROVAL_MOCK_TOKEN_SECRET=approval-service-local-dev-secret
APPROVAL_TOKEN_TTL_SECONDS=3600
APPROVAL_ESCALATION_ENABLED=true
APPROVAL_ESCALATION_APPROVED=false
APPROVAL_ESCALATION_MS=1000

# Command Module (auth_gateway) — runs as a separate stack; not started by this compose file
COMMAND_MODULE_IAM_API_URL=http://localhost:3012
COMMAND_MODULE_REDIS_SERVICE_URL=
COMMAND_MODULE_SESSION_COOKIE_NAME=session_id