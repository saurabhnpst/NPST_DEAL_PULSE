# DealPlus frontend — copy to `.env` for local development

# Business APIs via DealPlus API Gateway (use the port where the gateway actually listens)
VITE_API_BASE_URL=http://localhost:3010/api/v1

# Optional: if port 3000 is taken by another app, run gateway with PORT=3010 and point here instead
# VITE_API_BASE_URL=http://localhost:3010/api/v1

# Optional request timeout (ms)
# VITE_API_TIMEOUT_MS=120000

# Command Module auth routes (`/api/auth`, `/api/me`) — proxied by API Gateway when empty, use gateway origin
VITE_AUTH_BASE_URL=http://localhost:3010